{
  "name": "@vtrader/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for VTrader frontend and backend",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/index.js",
  "module": "dist/index.js",
  "scripts": {
    "build": "npm run clean && npm run build:umd",
    "build:umd": "tsc -p tsconfig.umd.json",
    "dev": "tsc -p tsconfig.umd.json --watch",
    "clean": "rimraf dist",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js"
    },
    "./prismaClient": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "typescript": "catalog:",
    "rimraf": "catalog:",
    "prisma": "^6.10.1",
    "@prisma/client": "^6.10.1"
  },
  "peerDependencies": {
    "typescript": ">=4.5.0"
  }
}
