{
  "name": "vtrader",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -F @vtrader/frontend run build && pnpm -F @vtrader/backend run build",
    "dev": "pnpm -F @vtrader/frontend run dev",
    "dev:frontend": "pnpm -F @vtrader/frontend run dev",
    "dev:backend": "pnpm -F @vtrader/backend run start:dev",
    "lint": "echo 'lint not configured'",
    "format": "prettier --write .",
    "check:type": "pnpm -F @vtrader/frontend run typecheck && pnpm -F @vtrader/backend run typecheck",
    "test:unit": "echo 'no tests'"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "overrides": {
      "esbuild": "0.25.3"
    },
    "neverBuiltDependencies": ["canvas", "node-gyp"]
  }
}
