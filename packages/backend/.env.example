# ==========================================
# VTrader Backend 环境变量
# 复制此文件为 .env 并填入真实值
# cp .env.example .env
# ==========================================

# MySQL 数据库连接 (Prisma)
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://root:YOUR_PASSWORD@127.0.0.1:3306/vtrader"

# Redis 连接 (BullMQ 消息队列)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# HTTP 代理 (可选，用于访问 Binance API)
# 留空则不使用代理
BINANCE_PROXY_URL=

# 主密钥 — 用于 AES-256-GCM 加密存储 Broker API Key/Secret
# 必须设置，长度建议 32 字符以上，生产环境请使用强随机字符串
# 注意: 更换此密钥会导致已加密的 Broker 凭证无法解密
MASTER_KEY=change-me-to-a-strong-random-string
